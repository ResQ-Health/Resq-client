{
    "name": "simple-node-api",
    "version": "1.0.0",
    "description": "Simple Node.js API with Express, MongoDB, and Redis",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "dev:mock-redis": "REDIS_ENABLED=false nodemon src/index.js",
        "generate-slots": "node src/scripts/generateTimeSlots.js",
        "scheduler": "node src/scripts/scheduledJobs.js",
        "test-email": "node src/scripts/testEmail.js",
        "build": "node -c src/index.js && node -c src/controllers/providerController.js && node -c src/controllers/paymentController.js && node -c src/controllers/reviewController.js && node -c src/controllers/locationController.js && node -c src/models/Provider.js && node -c src/models/Appointment.js && node -c src/models/SupportTicket.js && node -c src/models/ProviderReport.js",
        "test": "npm run build"
    },
    "dependencies": {
        "axios": "^1.9.0",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^1.41.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "firebase": "^12.6.0",
        "firebase-admin": "^11.11.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.2",
        "multer-storage-cloudinary": "^4.0.0",
        "nanoid": "^3.3.6",
        "node-cron": "^3.0.3",
        "nodemailer": "^6.10.1",
        "paystack-node": "^0.3.0",
        "pdfkit": "^0.17.2",
        "redis": "^4.6.11",
        "sharp": "^0.34.5",
        "sib-api-v3-sdk": "^8.5.0",
        "uuid": "^11.1.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "nodemon": "^3.0.2"
    }
}