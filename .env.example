# ====================================================================
# Backend API Configuration
# ====================================================================
# Local development API proxy target (used by Vite dev server, defaults to http://localhost:5001)
VITE_DEV_API_TARGET=http://localhost:5001

# Production target API URL (used in production builds or deployments)
VITE_API_URL=https://server-16pz.onrender.com

# Client Frontend App URL (default: http://localhost:5174 for local dev)
VITE_APP_URL=http://localhost:5174

# ====================================================================
# Firebase Configuration (Optional / If needed)
# ====================================================================
# VITE_FIREBASE_API_KEY=your_firebase_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
# VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
